{
  "manifest_version": 2,
  "name": "ZotFile",
  "version": "5.1.3",
  "description": "Advanced PDF management for Zotero",
  "applications": {
    "gecko": {
      "id": "zotfile@columbia.edu",
      "strict_min_version": "5.0",
      "strict_max_version": "10.*"
    },
    "zotero": {
      "id": "zotfile@columbia.edu",
      "strict_min_version": "5.0",
      "strict_max_version": "10.*",
      "update_url": "https://raw.githubusercontent.com/jlegewie/zotfile/master/zotfile-update.rdf"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "zotfile@columbia.edu",
      "strict_min_version": "5.0",
      "strict_max_version": "10.*"
    }
  }
}
